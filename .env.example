# ─────────────────────────────────────────────────────────────
#  Environment configuration
#  Rename this file to .env and fill in your actual secrets.
#  Never commit the .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────

# Supabase — used for caching summaries so the same video isn't
# reprocessed on repeated requests. The app works without this
# but will re-transcribe every time.
# Get these from your Supabase project settings > API.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Groq — used to generate the summary from the transcript.
# Get a free API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
